APP_NAME=CargoTrace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database (MySQL, mis. lewat Laragon). Buat dulu database kosong bernama "cargotrace".
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cargotrace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@cargotrace.test"
MAIL_FROM_NAME="${APP_NAME}"

# --- CargoTrace ---------------------------------------------------------------
# Aturan delay. Ubah sesuai parameter kelompok (12 / 18 / 24 jam), lalu: php artisan config:clear
# Shipment dianggap DELAYED jika ETA melewati expected arrival lebih dari nilai ini.
CARGOTRACE_DELAY_THRESHOLD_HOURS=0
# Batas severity: sampai LOW_MAX = LOW, sampai MEDIUM_MAX = MEDIUM, di atasnya HIGH.
CARGOTRACE_DELAY_LOW_MAX_HOURS=6
CARGOTRACE_DELAY_MEDIUM_MAX_HOURS=24
CARGOTRACE_DELAY_EXCEPTION_TYPE=PORT_CONGESTION

# Password akun demo dari `php artisan db:seed` (jangan dipakai di production).
DEMO_PASSWORD=password

# Kunci API berita (opsional, https://gnews.io). Kosongkan jika tidak dipakai.
GNEWS_API_KEY=
